{
  "name": "spy-fidelity",
  "version": "0.1.0",
  "description": "An API that counts the audio frames in an MPEG-1 Audio Layer III (MP3) file.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "setup": "npm ci && npm run typecheck && npm run check && npm test"
  },
  "dependencies": {
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  }
}
